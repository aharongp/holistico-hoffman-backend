# Add these variables to the backend project in Vercel. No secrets in VITE_*.
FILE_STORAGE_DRIVER=sftp
FILE_STORAGE_HOST=68.183.142.98
FILE_STORAGE_PORT=22
FILE_STORAGE_USERNAME=hoffman_files
# SFTP path inside the isolated account. Physical path: /var/www/html/sshh/public/assets.
FILE_STORAGE_ROOT=/assets
# Prefer a restricted SSH key. Accepts PEM with actual newlines or escaped \n.
FILE_STORAGE_PRIVATE_KEY=
FILE_STORAGE_PASSPHRASE=
# Alternative to a private key (not both required):
FILE_STORAGE_PASSWORD=
# SHA256 host-key hash as 64 lowercase hexadecimal characters, verified independently.
FILE_STORAGE_HOST_SHA256=931719aabf721961c5f201ab58762d624e37607a434ed9bb611d768c8d341468
# Local development only: FILE_STORAGE_DRIVER=local and absolute assets folder.
# FILE_STORAGE_LOCAL_ROOT=/absolute/path/to/sshh/public/assets
